<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Contrairement à l'app, l'extension EST sandboxée : macOS l'impose pour
         toute app extension. C'est la raison d'être du conteneur partagé —
         le widget ne peut pas lire le SMC lui-même. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>KFLACS69T9.fr.vincentlauriat.macinside</string>
    </array>
</dict>
</plist>
